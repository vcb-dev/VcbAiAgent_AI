# VCB_AI — AI & media service
# HOST / PORT / RELOAD: chỉ dùng local. Image Docker và Railway tự gắn (0.0.0.0, cổng inject, RELOAD=0).

# Shared secret: VCB_BE must send the same value in the X-Assistant-Secret header.
ASSISTANT_INTERNAL_SECRET=dev-assistant-secret-change-me

# Optional AI providers. Without them the service falls back to the rules planner
# and the offline macOS voice. ElevenLabs can also be set in local-secrets.json.
# ANTHROPIC_API_KEY=
# VCB_PLANNER_MODEL=claude-opus-5-5
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
